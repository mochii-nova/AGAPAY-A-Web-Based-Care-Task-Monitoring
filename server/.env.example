# Copy this file to .env and fill in the values. Never commit .env.

# MySQL (XAMPP defaults: host localhost, user root, empty password, port 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=agapay

PORT=5000

JWT_SECRET= 


GOOGLE_CLIENT_ID= 

# Web Push. Make the keys once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Before going online: the frontend's address (comma-separated if more than one).
# Empty = any address can call the API (fine for local development).
CLIENT_URL=
# The backend's public address, used for profile photo links. Empty = worked out per request.
PUBLIC_URL=
# Set to 1 when the server runs behind a hosting proxy (Render, Railway, Nginx...)
TRUST_PROXY=
